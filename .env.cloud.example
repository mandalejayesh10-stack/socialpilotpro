# Starter deployment: Railway can serve public HTTPS uploads directly.
# This is enough for Instagram/Facebook while traffic is small and one Railway
# backend instance owns the upload disk.
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_PUBLIC_BASE_URL="https://your-railway-api.up.railway.app"
BACKEND_PUBLIC_URL="https://your-railway-api.up.railway.app"

# Future scale-up: choose one cloud storage provider when Railway disk is not enough.

# Option 1: Supabase Storage
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_BUCKET="socialpilot-media"

# Option 2: AWS S3 + public CloudFront/custom CDN
# STORAGE_PROVIDER="s3"
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="socialpilot-media"
# AWS_S3_PUBLIC_URL="https://cdn.yourdomain.com"

# Option 3: Cloudflare R2 + public custom domain
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key"
# R2_SECRET_ACCESS_KEY="your-secret-key"
# R2_BUCKET="socialpilot-media"
# R2_PUBLIC_URL="https://media.yourdomain.com"

# App URLs in production, no ngrok.
FRONTEND_URL="https://your-vercel-app.vercel.app"
NEXT_PUBLIC_BACKEND_URL="https://your-railway-api.up.railway.app"
BACKEND_INTERNAL_URL="https://your-railway-api.up.railway.app"
